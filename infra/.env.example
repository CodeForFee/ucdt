# Copy to infra/.env (never committed). Compose reads it for variable substitution.

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_DB=ucdt
POSTGRES_USER=ucdt
# Change on the VPS. Postgres is never published outside the compose network.
POSTGRES_PASSWORD=ucdt

# ── climate (api + worker) ──────────────────────────────────────────────────
# Optional AQI fallbacks — Open-Meteo Air Quality needs no key and is tried first.
IQAIR_API_KEY=
AQICN_TOKEN=

# ── web (baked into the static bundle at build time — never a secret) ───────
# Mapbox scopes tokens by URL, so a public token restricted to your domain is correct here.
VITE_MAPBOX_TOKEN=
# Empty = same origin (/api via nginx). Only set when the API lives elsewhere.
VITE_API_BASE_URL=

# ── nginx + certbot (infra/nginx.conf.template, infra/certbot/) ─────────────
# nginx always terminates TLS: a bare domain here gets a real Let's Encrypt certificate
# (docs/DEPLOY.md, infra/certbot/init.sh); "localhost" (default) keeps the self-signed
# placeholder infra/certbot/dummy-cert.sh writes on first boot.
SITE_ADDRESS=localhost
