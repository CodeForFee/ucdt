# The only public entry point. SITE_ADDRESS=:80 serves plain HTTP by IP; a domain name
# (e.g. ucdt.example.org) turns on automatic HTTPS.
{$SITE_ADDRESS::80} {
	# /api/* -> gateway. flush_interval -1 streams responses unbuffered, which SSE
	# (/api/stream) needs. No `encode` here: compressing an event stream buffers it.
	handle /api/* {
		reverse_proxy gateway:3001 {
			flush_interval -1
		}
	}

	# Everything else is the SPA: real files if they exist, index.html otherwise.
	handle {
		root * /srv
		encode zstd gzip
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
