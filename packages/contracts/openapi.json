{
  "openapi": "3.1.0",
  "info": {
    "title": "UCDT climate API",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/weather/latest": {
      "get": {
        "tags": [
          "latest"
        ],
        "summary": "Latest",
        "operationId": "latest_weather",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WeatherLatest"
                }
              }
            }
          },
          "503": {
            "description": "no snapshot yet"
          }
        }
      }
    },
    "/v1/aqi/latest": {
      "get": {
        "tags": [
          "latest"
        ],
        "summary": "Latest",
        "operationId": "latest_aqi",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AQILatest"
                }
              }
            }
          },
          "503": {
            "description": "no snapshot yet"
          }
        }
      }
    },
    "/v1/flood/latest": {
      "get": {
        "tags": [
          "latest"
        ],
        "summary": "Latest",
        "operationId": "latest_flood",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FloodLatest"
                }
              }
            }
          },
          "503": {
            "description": "no snapshot yet"
          }
        }
      }
    },
    "/v1/heat/latest": {
      "get": {
        "tags": [
          "latest"
        ],
        "summary": "Latest",
        "operationId": "latest_heat",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HeatLatest"
                }
              }
            }
          },
          "503": {
            "description": "no snapshot yet"
          }
        }
      }
    },
    "/v1/recommend/latest": {
      "get": {
        "tags": [
          "latest"
        ],
        "summary": "Latest",
        "operationId": "latest_recommend",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendLatest"
                }
              }
            }
          },
          "503": {
            "description": "no snapshot yet"
          }
        }
      }
    },
    "/v1/alerts": {
      "get": {
        "tags": [
          "alerts"
        ],
        "summary": "List Alerts",
        "operationId": "list_alerts",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/alerts/read": {
      "post": {
        "tags": [
          "alerts"
        ],
        "summary": "Mark Read",
        "operationId": "mark_read",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MarkReadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarkReadResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/simulation": {
      "post": {
        "tags": [
          "simulation"
        ],
        "summary": "Simulate",
        "description": "Live what-if against the latest weather/flood/aqi snapshots (what legacy runSimulation fetched).",
        "operationId": "simulate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimulationRequest",
                "default": {
                  "cityId": "hcmc",
                  "scenario": {
                    "rainfallIncrease": 50.0,
                    "rainfallDurationHours": 3.0,
                    "addGreenCoverage": 0.0,
                    "trafficReduction": 0.0
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimulationResult"
                }
              }
            }
          },
          "503": {
            "description": "no snapshot yet"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/history/{hazard}": {
      "get": {
        "tags": [
          "history"
        ],
        "summary": "History",
        "description": "Snapshots of the last `hours`, oldest first.",
        "operationId": "history",
        "parameters": [
          {
            "name": "hazard",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Hazard"
            }
          },
          {
            "name": "hours",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 168,
              "minimum": 1,
              "default": 24,
              "title": "Hours"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HistoryEntry"
                  },
                  "title": "Response History"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Healthz",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Healthz"
                }
              }
            }
          }
        }
      }
    }
  },
